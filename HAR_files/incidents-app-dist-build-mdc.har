TEGORY2=Category 2\n#XLST: Chart's personalization dialog chart role\nchart.PERSONALIZATION_DIALOG_CHARTROLE_SERIES=Series\n#XLST: Chart's personalization dialog chart role\nchart.PERSONALIZATION_DIALOG_CHARTROLE_AXIS1=Axis 1\n#XLST: Chart's personalization dialog chart role\nchart.PERSONALIZATION_DIALOG_CHARTROLE_AXIS2=Axis 2\n#XLST: Chart's personalization dialog chart role\nchart.PERSONALIZATION_DIALOG_CHARTROLE_AXIS3=Axis 3\n#XLST: Chart's personalization dialog chart role\nchart.PERSONALIZATION_DIALOG_CHARTROLE_AXIS4=Axis 4\n#XTOL: Tooltip of the selected chart type button\nchart.CHART_TYPE_TOOLTIP=Selected Chart Type\\: {0}\n#XTIT: Chart type search field\nchart.CHART_TYPE_SEARCH=Search in Chart Types\n#XTXT: Chart type list text\nchart.CHART_TYPELIST_TEXT=Chart Type\n# XTOL: Tool tip for zoom buttons\nchart.TOOLBAR_ZOOM_IN=Zoom In\n# XTOL: Tool tip for zoom buttons\nchart.TOOLBAR_ZOOM_OUT=Zoom Out\n# XTOL: Tool tip for drilldown buttons\nchart.CHART_DRILLDOWN_TITLE=View By\n# XTOL: Tool tip for drilldown search field\nchart.CHART_DRILLDOWN_SEARCH=Search in Dimensions\n#XTOL: Legend button tooltip\nchart.LEGENDBTN_TOOLTIP=Toggle Legend Visibility\n#XTXT: Legend button text\nchart.LEGENDBTN_TEXT=Toggle Legend Visibility\n# XTXT: No data text for the chart\nchart.NO_DATA=No data available\n#XTXT: Warning when no chart types are available to select\nchart.NO_CHART_TYPES_AVAILABLE=No chart types available\n#XTXT: What to do to get more chart types available on the chart\nchart.NO_CHART_TYPES_AVAILABLE_ACTION=Try adjusting the chart settings.\n# XTXT: No data text for the chart with FilterBar\nchart.NO_DATA_WITH_FILTERBAR=To start, set the relevant filters.\n# XTXT: No data text for the chart when data is not found\nchart.NO_RESULTS=No data available. Try adjusting the filter settings.\n# XTXT: Name for \"Measure\" group of Chart personalization\nchart.PERSONALIZATION_DIALOG_MEASURE_GROUP_HEADER=Measures\n# XTXT: Name for \"Dimension\" group of Chart personalization\nchart.PERSONALIZATION_DIALOG_DIMENSION_GROUP_HEADER=Dimensions\n#XTXT: Placeholder for empty combobox of templating row\nchart.PERSONALIZATION_DIALOG_TEMPLATE_PLACEHOLDER=Select\n#XTXT: Warning when selected chart type can show only one measure\nchart.PERSONALIZATION_DIALOG_MEASURE_WARNING=The selected chart type can show only one measure at a time. Only the measure on top of the list will be shown.\n#XTXT: Tooltip for removing an entry from the p13n table\nchart.PERSONALIZATION_DIALOG_REMOVE_ENTRY=Remove\n#XTXT: screenreader announcemnt for removing an entry from the p13n table\nchart.PERSONALIZATION_DIALOG_REMOVE_ENTRY_ANNOUNCE=Item has been removed\n#XTXT: Information when there is no dimension available for a drill-down in the drill-down popover\nchart.NO_DRILLABLE_DIMENSION=No dimensions available\n#XTXT: Detailed Information when there is no dimension available for a drill-down in the drill-down popover\nchart.NO_DRILLABLE_DIMENSION_DESC=All available dimensions are already selected.\n# XTOL: Tooltip & text of the general chart settings dialog (which offers add/remove dimensions and measures, sort, filter, ...)\nchart.SETTINGS=Settings\n#XTXT: Information about how the chart is filtered. Singular. {0} contains the single filter value. For example: \"1 chart filter active: First name\"\nchart.ONE_FILTER_ACTIVE=1 chart filter active\\: {0}\n#XTXT: Information about how the chart is filtered. Plural. {0} contains the count of filters. {1} contains a comma-separated list of filtered values. For example: \"3 chart filters active: First name, Last name and Country\"\nchart.MULTIPLE_FILTERS_ACTIVE={0} chart filters active\\: {1}\n\n#XBUT: Navigation button\nchart.SELECTION_DETAILS_BTN=Jump To\n#XTOL: Navigation button tooltip\nchart.SELECTION_DETAILS_BTN_TOOLTIP=Jump To\n\n#XTXT: Text for UI Adaptation, describing add descending sort change visualization\nchart.SORT_ADD_CHANGE_DESC=Descending sorter \"{0}\" added  at position \"{1}\"\n#XTXT: Text for UI Adaptation, describing add ascending sort change visualization\nchart.SORT_ADD_CHANGE_ASC=Ascending sorter \"{0}\" added  at position \"{1}\"\n#XTXT: Text for UI Adaptation, describing remove sort change visualization\nchart.SORT_DEL_CHANGE=Sorter \"{0}\" removed\n#XTXT: Text for UI Adaptation, describing move sort change visualization\nchart.SORT_MOVE_CHANGE=Sorter \"{0}\" moved from position \"{1}\" to position \"{2}\"\n\n#XTXT: Text for UI Adaptation, describing add item change visualization\nchart.ITEM_ADD_CHANGE=Item \"{0}\" with layout option \"{1}\" added at position \"{2}\"\n#XTXT: Text for UI Adaptation, describing add dimension item change visualization\nchart.ITEM_ADD_CHANGE_DIM=Dimension item \"{0}\" with layout option \"{2}\" added at position \"{1}\"\n#XTXT: Text for UI Adaptation, describing add measure item change visualization\nchart.ITEM_ADD_CHANGE_MEAS=Measure item \"{0}\" added  at position \"{1}\"\n#XTXT: Text for UI Adaptation, describing remove item item change visualization\nchart.ITEM_DEL_CHANGE=Item \"{0}\" removed\n#XTXT: Text for UI Adaptation, describing remove dimension item change visualization\nchart.ITEM_DEL_CHANGE_DIM=Dimension item \"{0}\" removed\n#XTXT: Text for UI Adaptation, describing remove measure item change visualization\nchart.ITEM_DEL_CHANGE_MEAS=Measure item \"{0}\" removed\n#XTXT: Text for UI Adaptation, describing move dimension item change visualization\nchart.ITEM_MOVE_CHANGE_DIM=Dimension item \"{0}\" moved from position \"{1}\" to position \"{2}\"\n#XTXT: Text for UI Adaptation, describing move dimension item change visualization\nchart.ITEM_MOVE_CHANGE_MEAS=Measure item \"{0}\" moved from position \"{1}\" to position \"{2}\"\n\n#XMSG: Additional announcement for screen reader when chart is updated. Contains the header and chart type\nchart.ANNOUNCEMENT_UPDATED=The {0} chart of type {1} has been updated.\n\n#XMSG: Additional announcement for screen reader when chart is updated, contains the number of used dimensions and measures\nchart.ANNOUNCEMENT_DIMMEA_NN_UPDATED={0} dimensions and {1} measures are available.\nchart.ANNOUNCEMENT_DIMMEA_1N_UPDATED={0} dimension and{1} measures are available.\nchart.ANNOUNCEMENT_DIMMEA_N1_UPDATED={0} dimensions and {1} measure are available.\nchart.ANNOUNCEMENT_DIMMEA_11_UPDATED={0} dimension and {1} measure are available.\n\n# XTOL: Tooltip & text of the add/remove column settings dialog\ntable.SETTINGS_COLUMN=Columns\n# XTOL: Tooltip & text of the button that opens the general table settings dialog (which offers add/remove column, sort, filter, group, ...)\ntable.SETTINGS=Settings\n# XTXT: No data text for the table\ntable.NO_DATA=No data available\n# XTXT: No data text for the table with FilterBar\ntable.NO_DATA_WITH_FILTERBAR=To start, set the relevant filters.\n# XTXT: No data text for the table when data is not found\ntable.NO_RESULTS=No data available. Try adjusting the filter settings.\n# XTXT: No data message title for the table when data is not found\ntable.NO_RESULTS_TITLE=No data available\n# XTXT: No data message description for the table when data is not found\ntable.NO_RESULTS_DESCRIPTION=Try adjusting the filter settings.\n#XTXT: Show Details button\ntable.SHOWDETAILS_TEXT=Show More per Row\n#XTXT: Hide Details button\ntable.HIDEDETAILS_TEXT=Show Less per Row\n#XTXT: Information about how the table is filtered. Singular. {0} contains the single filter value. For example: \"1 table filter active: First name\"\ntable.ONE_FILTER_ACTIVE=1 table filter active\\: {0}\n#XTXT: Information about how the table is filtered. Plural. {0} contains the count of filters. {1} contains a comma-separated list of filtered values. For example: \"3 table filters active: First name, Last name and Country\"\ntable.MULTIPLE_FILTERS_ACTIVE={0} table filters active\\: {1}\n#XTOL: Export button\ntable.EXPORT_BUTTON_TEXT=Export Table\n#XBUT: Menu item Export\ntable.QUICK_EXPORT=Export\n#XBUT: Menu item Export with settings\ntable.EXPORT_WITH_SETTINGS=Export As...\n#XMSG: Text for table when no columns are present and export is triggered\ntable.NO_COLS_EXPORT=Right now, there are no visible columns in the table. \\nBefore you perform an export, please select the columns you need in the table settings.\n#XMSG: Additional announcement for screen reader when table is updated\ntable.ANNOUNCEMENT_TABLE_UPDATED=Table {0} has been updated. Items available.\n#XMSG: Additional announcement for screen reader when table is updated and contains only 1 item\ntable.ANNOUNCEMENT_TABLE_UPDATED_SING=Table {0} has been updated. {1} item available.\n#XMSG: Additional announcement for screen reader when table is updated and contains more than 1 item\ntable.ANNOUNCEMENT_TABLE_UPDATED_MULT=Table {0} has been updated. {1} items available.\n#XMSG: Additional announcement for screen reader when table is updated and contains no items\ntable.ANNOUNCEMENT_TABLE_UPDATED_NOITEMS=Table {0} has been updated. No items available.\n#XTOL: Shortcut hint for the export to excel button.\ntable.SHORTCUT_EXPORT_TO_EXCEL=Ctrl+Shift+E\n#XTOL: Shortcut hint for the export to excel button for Mac.\ntable.SHORTCUT_EXPORT_TO_EXCEL_MAC=Cmd+Shift+E\n#XMSG: Message text on sort panel when sorting is set for invisible columns\ntable.PERSONALIZATION_DIALOG_SORT_RESTRICTION=You can only sort visible columns. If a column has not been made visible, it will not be sorted.\n#XMSG: Message text on group panel when totals is applied on the table\ntable.PERSONALIZATION_DIALOG_GROUP_RESTRICTION_TOTALS=You cannot see columns {0} here since totals have been used. Remove totals to see these columns.\n#XMSG: Message text on group panel when grouping is set for invisible columns\ntable.PERSONALIZATION_DIALOG_GROUP_RESTRICTION_VISIBLE=You can only group visible columns. If a column has not been made visible, it will not be grouped.\n#XMSG: Message text on sort panel when sorting is set for invisible columns\ntable.PERSONALIZATION_DIALOG_TOTAL_RESTRICTION=You can only calculate totals for visible columns. If a column has not been made visible, totals will not be shown.\n#XMSG: Message for P13n Filter Dialog when the table is filtered by related messages.\ntable.PERSONALIZATION_DIALOG_FILTER_MESSAGESTRIP=The table was filtered for rows with related messages. The defined filters are temporarily ignored.\n#XTXT: Title of group headers. For example: \"Country: Germany\"\ntable.ROW_GROUP_TITLE={0}: {1}\n#XTXT: Title of group headers with a combination of ID and text. For example: \"Country: 001 - Germany\"\ntable.ROW_GROUP_TITLE_FULL={0}: {1} - {2}\n#XTOL: Tooltip and text for the \"Collapse Entire Tree\" menu item in the Tree Toolbar\ntable.COLLAPSE_TREE=Collapse Entire Tree\n#XTOL: Tooltip and text for the \"Collapse Entire Node\" menu item in the Tree Toolbar\ntable.COLLAPSE_NODE=Collapse Entire Node\n#XTOL: Tooltip and text for the \"Collapse Entire Tree\" and \"Collapse Entire Node\" menu button\ntable.COLLAPSE_MENU_BUTTON_TEXT=Collapse Entire Tree/Node\n#XTOL: Tooltip and text for the \"Expand Entire Tree\" menu item in the Tree Toolbar\ntable.EXPAND_TREE=Expand Entire Tree\n#XTOL: Tooltip and text for the \"Expand Entire Node\" menu item in the Tree Toolbar\ntable.EXPAND_NODE=Expand Entire Node\n#XTOL: Tooltip and text for the \"Expand Entire Tree\" and \"Expand Entire Node\" menu button\ntable.EXPAND_MENU_BUTTON_TEXT=Expand Entire Tree/Node\n#XTXT: Text for UI Adaptation, describing add column item change visualization\ntable.ITEM_ADD_CHANGE=Column \"{0}\" added at position \"{1}\"\n#XTXT: Text for UI Adaptation, describing remove column item change visualization\ntable.ITEM_DEL_CHANGE=Column \"{0}\" removed\n#XTXT: Text for UI Adaptation, describing move column item change visualization\ntable.ITEM_MOVE_CHANGE=Column \"{0}\" moved from position \"{1}\" to position \"{2}\"\n#XTXT: Text for UI Adaptation, describing add column for grouping change visualization\ntable.GROUP_ITEM_ADD_CHANGE=Group condition \"{0}\" added at position \"{1}\"\n#XTXT: Text for UI Adaptation, describing remove column for grouping change visualization\ntable.GROUP_ITEM_DEL_CHANGE=Group condition \"{0}\" removed\n#XTXT: Text for UI Adaptation, describing move column for grouping change visualization\ntable.GROUP_ITEM_MOVE_CHANGE=Group condition \"{0}\" moved from position \"{1}\" to position \"{2}\"\n#XMIT: Menu item that contains submenu items for ungroup actions\ntable.TBL_UNGROUP=Ungroup\n#XMIT: Menu item to remove a certain group level\ntable.TBL_UNGROUP_LEVEL=Ungroup Level\n#XMIT: Menu item to remove all group levels\ntable.TBL_UNGROUP_ALL=Ungroup All\n\n# XTIT: Title of the Columns list (in p13nDialog)\nfieldsui.COLUMNS=Columns\n\n#XTOL: Collective Search predefined text for tooltip on trigger button\nCOL_SEARCH_TRIGGER_TT=Select Search Template\n#XTIT: Collective Search predefined text for invisible text. Accessibility support.\nCOL_SEARCH_SEL_INVISIBLETXT=Search Template {0}. To open press spacebar.\n#XTIT: Collective Search predefined title text.\nCOL_SEARCH_SEL_TITLE=Select Search Template\n#XTXT: when nothing was found\nCOL_SEARCH_SEL_NODATA_FOUND=No search templates found\n\n# XTIT: ActionToolbar's RTA personalization dialog title\nactiontoolbar.RTA_TITLE=Toolbar Configuration\n# XTOL: Tooltip & text of the add/remove action settings dialog\nactiontoolbar.RTA_COLUMN_HEADER=Actions\n# XTOL: Tooltip & text of the add/remove action settings dialog\nactiontoolbar.RTA_SETTINGS_NAME=Toolbar Actions\n#XTXT: Text for UI Adaptation, describing move action visualization\nactiontoolbar.ITEM_MOVE_CHANGE=Action item \"{0}\" moved from position \"{1}\" to position \"{2}\"\n\n#XMSG: Message to warn user that the export function is not available due to the missing library\nERROR_MISSING_EXPORT_LIBRARY=The export function is not available due to the missing sap.ui.export library. The library must be loaded to enable exports.\n"
