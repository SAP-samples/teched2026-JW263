            "text": "{\n  \"_version\": \"1.21.0\",\n  \"sap.app\": {\n    \"id\": \"sap.ui.fl\",\n    \"type\": \"library\",\n    \"embeds\": [\n      \"support/apps/contentbrowser\",\n      \"variants/context\"\n    ],\n    \"applicationVersion\": {\n      \"version\": \"1.139.0\"\n    },\n    \"title\": \"SAPUI5 library with sap.ui.fl controls.\",\n    \"description\": \"SAPUI5 library with sap.ui.fl controls.\",\n    \"ach\": \"CA-UI5-FL\",\n    \"resources\": \"resources.json\",\n    \"offline\": true\n  },\n  \"sap.ui\": {\n    \"technology\": \"UI5\",\n    \"supportedThemes\": [\n      \"base\",\n      \"sap_hcb\"\n    ]\n  },\n  \"sap.ui5\": {\n    \"dependencies\": {\n      \"minUI5Version\": \"1.139\",\n      \"libs\": {\n        \"sap.ui.core\": {\n          \"minVersion\": \"1.139.0\"\n        },\n        \"sap.m\": {\n          \"minVersion\": \"1.139.0\"\n        }\n      }\n    },\n    \"library\": {\n      \"i18n\": {\n        \"bundleUrl\": \"messagebundle.properties\",\n        \"supportedLocales\": [\n          \"\",\n          \"ar\",\n          \"bg\",\n          \"ca\",\n          \"cnr\",\n          \"cs\",\n          \"cy\",\n          \"da\",\n          \"de\",\n          \"el\",\n          \"en\",\n          \"en-GB\",\n          \"en-US-sappsd\",\n          \"en-US-saprigi\",\n          \"en-US-saptrc\",\n          \"es\",\n          \"es-MX\",\n          \"et\",\n          \"fi\",\n          \"fr\",\n          \"fr-CA\",\n          \"hi\",\n          \"hr\",\n          \"hu\",\n          \"id\",\n          \"it\",\n          \"iw\",\n          \"ja\",\n          \"kk\",\n          \"ko\",\n          \"lt\",\n          \"lv\",\n          \"mk\",\n          \"ms\",\n          \"nl\",\n          \"no\",\n          \"pl\",\n          \"pt\",\n          \"pt-PT\",\n          \"ro\",\n          \"ru\",\n          \"sh\",\n          \"sk\",\n          \"sl\",\n          \"sr\",\n          \"sv\",\n          \"th\",\n          \"tr\",\n          