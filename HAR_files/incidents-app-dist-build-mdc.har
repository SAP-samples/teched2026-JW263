            "mimeType": "text/plain",
            "text": "\n\nT_LR_VARIANT_APPLY_AUTOMATICALLY_WHEN_FILTER_SET=If predefined filter values are available, the content loads automatically.\n\n\n\nT_ANNOTATION_HELPER_DEFAULT_HEADER_TITLE_NO_HEADER_INFO=Unnamed Object\n\nT_NEW_OBJECT=New Object\n\nT_NEW_OBJECT_DEFAULT=New Object\n\nC_EDITFLOW_OBJECT_PAGE_SESSION_EXPIRED_DIALOG_TITLE=Session Expired\n\nC_EDITFLOW_OBJECT_PAGE_SESSION_EXPIRED_DIALOG_MESSAGE=Your editing session has expired. Any unsaved changes have been lost.\\nChoose OK to go back to the previous page.\n\nT_OP_RELATED_APPS=Related Apps\n\nT_COMMON_OBJECT_PAGE_APPLY_DRAFT=Apply\n\nT_COMMON_OBJECT_PAGE_VALIDATE_DRAFT=Validate\n\nT_OP_OBJECT_PAGE_CREATE=Create\n\nT_OP_OBJECT_PAGE_SAVE=Save\n\nC_COMMON_OBJECT_PAGE_SAVED_VERSION_BUT=Saved Version\n\nC_COMMON_OBJECT_PAGE_DRAFT_BUT=Draft\n\nC_COMMON_OBJECT_PAGE_DISPLAY_SAVED_VERSION_MIT=Saved Version\n\nC_COMMON_OBJECT_PAGE_DISPLAY_DRAFT_MIT=Draft\n\nT_COMMON_OBJECT_PAGE_HEADER_SECTION=Header\n\nT_COMMON_OBJECT_PAGE_OBJECT_INFO=Object Information\n\nT_COMMON_OBJECT_PAGE_FOOTER=Object Footer Area\n\n\nT_SHARE_UTIL_HELPER_SAPFE_SHARE_EMAIL=Send E-Mail\n\nT_COMMON_SAPFE_SHARE_JAM=Share in SAP Jam\n\nT_SHARE_UTIL_HELPER_SAPFE_EMAIL_SUBJECT=Link to\\: {0}\n\nT_COMMON_SAPFE_ACTION_SHARE_TOOLTIP=Share ({0})\n\n\nT_ANNOTATION_HELPER_PROGRESS_INDICATOR_DISPLAY_VALUE_UOM_IS_PERCENT={0}%\n\nT_ANNOTATION_HELPER_PROGRESS_INDICATOR_DISPLAY_VALUE_UOM_IS_NOT_PERCENT={0} of {1} {2}\n\nT_ANNOTATION_HELPER_PROGRESS_INDICATOR_DISPLAY_VALUE_UOM_IS_NOT_PERCENT_NO_TARGET_VALUE={0} {2}\n\n\nT_ANNOTATION_HELPER_RATING_INDICATOR_SUBTITLE_LABEL=rating\n\nT_ANNOTATION_HELPER_RATING_INDICATOR_SUBTITLE_LABEL_PLURAL=ratings\n\nT_ANNOTATION_HELPER_RATING_INDICATOR_SUBTITLE={0} {1}\n\nT_HEADER_RATING_INDICATOR_FOOTER={0} out of {1}\n\nT_COMMON_RATING_INDICATOR_AGGREGATE_COUNT=({0})\n\nT_COMMON_RATING_INDICATOR_TITLE_LABEL=Rating\n\n\nT_PAGINATOR_CONTROL_PAGINATOR_TOOLTIP_UP=Previous Item\n\nT_PAGINATOR_CONTROL_PAGINATOR_TOOLTIP_DO