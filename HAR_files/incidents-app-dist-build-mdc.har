            "text": "/*!SAP_POSTPROCESS_REDUCE_START*//*!SAP_POSTPROCESS_REDUCE_END*/.sapUiAccKeysHighlighDom:first-letter{text-decoration:underline 20% black}.sapFeControlsToken .sapFeControlsTokenPropertyName{color:var(--sapLinkColor)}.sapFeControlsToken.sapFeTokenError{background-color:#ffeaf4;border:.0625rem solid #e90b0b}.sapFeControlsToken .sapFeControlsTokenPropertyValues{margin-left:0.25rem;font-weight:bold}.sapFeControlsToken .sapFeControlsTokenPropertyValues.sapFeControlsTokenMandatory{font-weight:normal;color:#556b82}.sapFeControlsToken:not(.sapFeControlsTokenMandatory){padding-right:0.3125rem}.sapFeControlsToken:first-child{margin-left:0.3125rem}.sapFeControlsToken:nth-child(1):not(:first-line){margin-left:0}.sapFeControlsToken.sapFeControlsTokenMandatory{padding-right:0.3125rem}.sapFeControlsToken.sapFeControlsTokenMandatory .sapFeControlsTokenPropertyName{max-width:none}.sapFeControlsToken.sapFeControlsTokenMandatory .sapFeControlsTokenPropertyName::after{content:\"*\";color:#ba066c;font-family:\"72\",\"72full\",Arial,Helvetica,sans-serif;font-size:1rem;font-weight:bold;vertical-align:middle;line-height:0;margin-left:0.125rem}html.sap-desktop .sapFeControlsToken.sapFeTokenError:not(.sapMTokenSelected):not(.sapMTokenReadOnly):not(:focus):hover{background-color:transparent;border:.0625rem solid #e90b0b}.sapFeControlsTitleBorder{border-bottom:1px solid var(--sapList_BorderColor);padding-left:1rem;padding-top:0.5rem;padding-right:1rem;padding-bottom:0.5rem;background-color:#eff1f2}.sapFEControlsPointer{cursor:pointer !important}.sapFEControlsPopover{max-width:68.5625rem}.sapFEControlsPopover .sapMPopoverCont{width:inherit !important}.sapFEControlsPopover .sapFEControlsSuggestionsContainer .sapMFlexItem{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:inline-block;max-width:100%}.sapFEControlsPopover .sapFEControlsSuggestionsContainer .sapMFlexItem .sapMBtn{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:inline-block;max-width:100%}.sapUiMedia-DeviceSet-small .sapFEControlsPopover{margin-right:1rem;left:1rem !important}.sapMPopover.sapFEControlsPopover .sapMPopoverScroll{display:inherit}.sapFEControlsPopover{margin-right:3rem;left:3rem !important}@media (min-width:600px) and (max-width:1439px){.sapFEControlsPopover{left:2rem !important}}.sapFeControlsTokenizer.sapMTokenizer{padding-left:0}.sapFeControlsTokenizer.sapMTokenizer .sapMTokenizerScrollContainer{display:flex;flex-direction:row;flex-wrap:wrap}html.sap-desktop .sapMTokenizer.sapFeControlsTokenizer:focus{outline:none}html.sap-desktop .sapMTokenizer.sapFeControlsTokenizer:focus-visible{outline:.125rem solid #0032a5}.sapFeControlsGap8px{gap:0.5rem}.sapFeControlsAiPopoverText1{padding:1rem 1rem 0.5rem 1rem}.sapFeControlsAiPopoverText2{padding:0.5rem 1rem 1rem 1rem}.sapFEEasyFilterInput{width:100%}.sapFeInlineEditIndicator{position:absolute;z-index:1;border-top:1px solid var(--sapField_BorderColor);display:block}.sapFeInlineEditIndicatorIcon{float:right;box-shadow:var(--sapContent_Shadow2);width:40px;height:32px;border-radius:var(--sapButton_BorderCornerRadius);border:var(--sapButton_BorderColor);background-color:var(--sapButton_Background)}.sapFeInlineEditIndicatorIcon.sapFeInlineEditIndicatorAcceptDeclineIcon{width:4.65rem}.sapFeInlineEditIndicatorIcon .sapMBtn{padding-top:0.1rem;padding-left:0.15rem;width:2rem;height:1.625rem;margin:0.1rem}.sapFeInlineEditIndicatorIcon .sapMBtnInner{width:2rem;height:1.625rem;min-width:2rem}.sapFeInlineEditIndicatorIcon .sapMBtnIcon{line-height:1.625rem;height:1.625rem;width:2rem}.sapFeInlineEditIndicatorEditMode{border-top:0px}.sapFeControlsUnitCurrencyHbox{direction:ltr}.sapFeEasyFillReviewArea{background-color:var(--sapShell_Background)}.sapFeEasyFillReviewArea>.sapMFlexItem.sapUiContentPadding{padding:0}.sapFeEasyFillPlaceholder{background-color:var(--sapShell_Background);height:100%}.sapFeQuickViewFullWidth{width:100%}\n/* Inline theming parameters */\n#sap-ui-theme-sap\\.fe\\.controls{background-image:url('data:text/plain;utf-8,%7B%7D')}\n"
