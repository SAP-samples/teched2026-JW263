          "content": {
            "size": 51694,
            "mimeType": "application/xml",
            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<edmx:Edmx Version=\"4.0\" xmlns:edmx=\"http://docs.oasis-open.org/odata/ns/edmx\">\n  <edmx:Reference Uri=\"https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Capabilities.V1.xml\">\n    <edmx:Include Alias=\"Capabilities\" Namespace=\"Org.OData.Capabilities.V1\"/>\n  </edmx:Reference>\n  <edmx:Reference Uri=\"https://sap.github.io/odata-vocabularies/vocabularies/Common.xml\">\n    <edmx:Include Alias=\"Common\" Namespace=\"com.sap.vocabularies.Common.v1\"/>\n  </edmx:Reference>\n  <edmx:Reference Uri=\"https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml\">\n    <edmx:Include Alias=\"Core\" Namespace=\"Org.OData.Core.V1\"/>\n  </edmx:Reference>\n  <edmx:Reference Uri=\"https://sap.github.io/odata-vocabularies/vocabularies/UI.xml\">\n    <edmx:Include Alias=\"UI\" Namespace=\"com.sap.vocabularies.UI.v1\"/>\n  </edmx:Reference>\n  <edmx:Reference Uri=\"https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Validation.V1.xml\">\n    <edmx:Include Alias=\"Validation\" Namespace=\"Org.OData.Validation.V1\"/>\n  </edmx:Reference>\n  <edmx:DataServices>\n    <Schema Namespace=\"ProcessorService\" xmlns=\"http://docs.oasis-open.org/odata/ns/edm\">\n      <Annotation Term=\"Core.Links\">\n        <Collection>\n          <Record>\n            <PropertyValue Property=\"rel\" String=\"author\"/>\n            <PropertyValue Property=\"href\" String=\"https://cap.cloud.sap\"/>\n          </Record>\n        </Collection>\n      </Annotation>\n      <EntityContainer Name=\"EntityContainer\">\n        <EntitySet Name=\"Incidents\" EntityType=\"ProcessorService.Incidents\">\n          <NavigationPropertyBinding Path=\"customer\" Target=\"Customers\"/>\n          <NavigationPropertyBinding Path=\"urgency\" Target=\"Urgency\"/>\n          <NavigationPropertyBinding Path=\"status\" Target=\"Status\"/>\n          <NavigationPropertyBinding Path=\"conversation\" Target=\"Incidents_conversation\"/>\n          <NavigationPropertyBinding Path=\"processors\" Target=\"Incidents_processors\"/>\n          <NavigationPropertyBinding Path=\"SiblingEntity\" Target=\"Incidents\"/>\n        </EntitySet>\n        <EntitySet Name=\"Customers\" EntityType=\"ProcessorService.Customers\">\n          <NavigationPropertyBinding Path=\"incidents\" Target=\"Incidents\"/>\n          <NavigationPropertyBinding Path=\"addresses\" Target=\"Addresses\"/>\n        </EntitySet>\n        <EntitySet Name=\"Addresses\" EntityType=\"ProcessorService.Addresses\">\n          <NavigationPropertyBinding Path=\"customer\" Target=\"Customers\"/>\n        </EntitySet>\n        <EntitySet Name=\"Urgency\" EntityType=\"ProcessorService.Urgency\">\n          <NavigationPropertyBinding Path=\"texts\" Target=\"Urgency_texts\"/>\n          <NavigationPropertyBinding Path=\"localized\" Target=\"Urgency_texts\"/>\n        </EntitySet>\n        <EntitySet Name=\"Status\" EntityType=\"ProcessorService.Status\">\n          <NavigationPropertyBinding Path=\"texts\" Target=\"Status_texts\"/>\n          <NavigationPropertyBinding Path=\"localized\" Target=\"Status_texts\"/>\n        </EntitySet>\n        <EntitySet Name=\"Processors\" EntityType=\"ProcessorService.Processors\">\n          <NavigationPropertyBinding Path=\"incidents\" Target=\"Incidents_processors\"/>\n        </EntitySet>\n        <EntitySet Name=\"Urgency_texts\" EntityType=\"ProcessorService.Urgency_texts\"/>\n        <EntitySet Name=\"Status_texts\" EntityType=\"ProcessorService.Status_texts\"/>\n        <EntitySet Name=\"Incidents_conversation\" EntityType=\"ProcessorService.Incidents_conversation\">\n          <NavigationPropertyBinding Path=\"up_\" Target=\"Incidents\"/>\n          <NavigationPropertyBinding Path=\"SiblingEntity\" Target=\"Incidents_conversation\"/>\n        </EntitySet>\n        <EntitySet Name=\"Incidents_processors\" EntityType=\"ProcessorService.Incidents_processors\">\n          <NavigationPropertyBinding Path=\"up_\" Target=\"Incidents\"/>\n          <NavigationPropertyBinding Path=\"processor\" Target=\"Processors\"/>\n          <NavigationPropertyBinding Path=\"SiblingEntity\" Target=\"Incidents_processors\"/>\n        </EntitySet>\n      </EntityContainer>\n      <EntityType Name=\"Incidents\">\n        <Key>\n          <PropertyRef Name=\"ID\"/>\n          <PropertyRef Name=\"IsActiveEntity\"/>\n        </Key>\n        <Property Name=\"ID\" Type=\"Edm.Guid\" Nullable=\"false\"/>\n        <Property Name=\"createdAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"createdBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"modifiedAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"modifiedBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <NavigationProperty Name=\"customer\" Type=\"ProcessorService.Customers\" Partner=\"incidents\">\n          <ReferentialConstraint Property=\"customer_ID\" ReferencedProperty=\"ID\"/>\n        </NavigationProperty>\n        <Property Name=\"customer_ID\" Type=\"Edm.String\"/>\n        <Property Name=\"title\" Type=\"Edm.String\"/>\n        <NavigationProperty Name=\"urgency\" Type=\"ProcessorService.Urgency\">\n          <ReferentialConstraint Property=\"urgency_code\" ReferencedProperty=\"code\"/>\n        </NavigationProperty>\n        <Property Name=\"urgency_code\" Type=\"Edm.String\" DefaultValue=\"M\"/>\n        <NavigationProperty Name=\"status\" Type=\"ProcessorService.Status\">\n          <ReferentialConstraint Property=\"status_code\" ReferencedProperty=\"code\"/>\n        </NavigationProperty>\n        <Property Name=\"status_code\" Type=\"Edm.String\" DefaultValue=\"N\"/>\n        <NavigationProperty Name=\"conversation\" Type=\"Collection(ProcessorService.Incidents_conversation)\" Partner=\"up_\">\n          <OnDelete Action=\"Cascade\"/>\n        </NavigationProperty>\n        <NavigationProperty Name=\"processors\" Type=\"Collection(ProcessorService.Incidents_processors)\" Partner=\"up_\">\n          <OnDelete Action=\"Cascade\"/>\n        </NavigationProperty>\n        <Property Name=\"IsActiveEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"true\"/>\n        <Property Name=\"HasActiveEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"false\"/>\n        <Property Name=\"HasDraftEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"false\"/>\n        <NavigationProperty Name=\"DraftAdministrativeData\" Type=\"ProcessorService.DraftAdministrativeData\" ContainsTarget=\"true\"/>\n        <NavigationProperty Name=\"SiblingEntity\" Type=\"ProcessorService.Incidents\"/>\n        <Property Name=\"DraftMessages\" Type=\"Collection(ProcessorService.DRAFT_DraftAdministrativeData_DraftMessage)\" Nullable=\"true\"/>\n      </EntityType>\n      <EntityType Name=\"Customers\">\n        <Key>\n          <PropertyRef Name=\"ID\"/>\n        </Key>\n        <Property Name=\"createdAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"createdBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"modifiedAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"modifiedBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"ID\" Type=\"Edm.String\" Nullable=\"false\"/>\n        <Property Name=\"firstName\" Type=\"Edm.String\"/>\n        <Property Name=\"lastName\" Type=\"Edm.String\"/>\n        <Property Name=\"name\" Type=\"Edm.String\"/>\n        <Property Name=\"email\" Type=\"Edm.String\"/>\n        <Property Name=\"phone\" Type=\"Edm.String\"/>\n        <NavigationProperty Name=\"incidents\" Type=\"Collection(ProcessorService.Incidents)\" Partner=\"customer\"/>\n        <Property Name=\"creditCardNo\" Type=\"Edm.String\" MaxLength=\"16\"/>\n        <NavigationProperty Name=\"addresses\" Type=\"Collection(ProcessorService.Addresses)\" Partner=\"customer\">\n          <OnDelete Action=\"Cascade\"/>\n        </NavigationProperty>\n      </EntityType>\n      <EntityType Name=\"Addresses\">\n        <Key>\n          <PropertyRef Name=\"ID\"/>\n        </Key>\n        <Property Name=\"ID\" Type=\"Edm.Guid\" Nullable=\"false\"/>\n        <Property Name=\"createdAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"createdBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"modifiedAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"modifiedBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <NavigationProperty Name=\"customer\" Type=\"ProcessorService.Customers\" Partner=\"addresses\">\n          <ReferentialConstraint Property=\"customer_ID\" ReferencedProperty=\"ID\"/>\n        </NavigationProperty>\n        <Property Name=\"customer_ID\" Type=\"Edm.String\"/>\n        <Property Name=\"city\" Type=\"Edm.String\"/>\n        <Property Name=\"postCode\" Type=\"Edm.String\"/>\n        <Property Name=\"streetAddress\" Type=\"Edm.String\"/>\n      </EntityType>\n      <EntityType Name=\"Urgency\">\n        <Key>\n          <PropertyRef Name=\"code\"/>\n        </Key>\n        <Property Name=\"name\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"descr\" Type=\"Edm.String\" MaxLength=\"1000\"/>\n        <Property Name=\"code\" Type=\"Edm.String\" Nullable=\"false\"/>\n        <NavigationProperty Name=\"texts\" Type=\"Collection(ProcessorService.Urgency_texts)\">\n          <OnDelete Action=\"Cascade\"/>\n        </NavigationProperty>\n        <NavigationProperty Name=\"localized\" Type=\"ProcessorService.Urgency_texts\">\n          <ReferentialConstraint Property=\"code\" ReferencedProperty=\"code\"/>\n        </NavigationProperty>\n      </EntityType>\n      <EntityType Name=\"Status\">\n        <Key>\n          <PropertyRef Name=\"code\"/>\n        </Key>\n        <Property Name=\"name\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"descr\" Type=\"Edm.String\" MaxLength=\"1000\"/>\n        <Property Name=\"code\" Type=\"Edm.String\" Nullable=\"false\"/>\n        <Property Name=\"criticality\" Type=\"Edm.Int32\"/>\n        <NavigationProperty Name=\"texts\" Type=\"Collection(ProcessorService.Status_texts)\">\n          <OnDelete Action=\"Cascade\"/>\n        </NavigationProperty>\n        <NavigationProperty Name=\"localized\" Type=\"ProcessorService.Status_texts\">\n          <ReferentialConstraint Property=\"code\" ReferencedProperty=\"code\"/>\n        </NavigationProperty>\n      </EntityType>\n      <EntityType Name=\"Processors\">\n        <Key>\n          <PropertyRef Name=\"ID\"/>\n        </Key>\n        <Property Name=\"createdAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"createdBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"modifiedAt\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"modifiedBy\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"ID\" Type=\"Edm.String\" Nullable=\"false\"/>\n        <Property Name=\"firstName\" Type=\"Edm.String\"/>\n        <Property Name=\"lastName\" Type=\"Edm.String\"/>\n        <NavigationProperty Name=\"incidents\" Type=\"Collection(ProcessorService.Incidents_processors)\" Partner=\"processor\"/>\n      </EntityType>\n      <EntityType Name=\"DraftAdministrativeData\">\n        <Key>\n          <PropertyRef Name=\"DraftUUID\"/>\n        </Key>\n        <Property Name=\"DraftUUID\" Type=\"Edm.Guid\" Nullable=\"false\"/>\n        <Property Name=\"CreationDateTime\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"CreatedByUser\" Type=\"Edm.String\" MaxLength=\"256\"/>\n        <Property Name=\"DraftIsCreatedByMe\" Type=\"Edm.Boolean\"/>\n        <Property Name=\"LastChangeDateTime\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"LastChangedByUser\" Type=\"Edm.String\" MaxLength=\"256\"/>\n        <Property Name=\"InProcessByUser\" Type=\"Edm.String\" MaxLength=\"256\"/>\n        <Property Name=\"DraftIsProcessedByMe\" Type=\"Edm.Boolean\"/>\n      </EntityType>\n      <EntityType Name=\"Urgency_texts\">\n        <Key>\n          <PropertyRef Name=\"locale\"/>\n          <PropertyRef Name=\"code\"/>\n        </Key>\n        <Property Name=\"locale\" Type=\"Edm.String\" MaxLength=\"14\" Nullable=\"false\"/>\n        <Property Name=\"name\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"descr\" Type=\"Edm.String\" MaxLength=\"1000\"/>\n        <Property Name=\"code\" Type=\"Edm.String\" Nullable=\"false\"/>\n      </EntityType>\n      <EntityType Name=\"Status_texts\">\n        <Key>\n          <PropertyRef Name=\"locale\"/>\n          <PropertyRef Name=\"code\"/>\n        </Key>\n        <Property Name=\"locale\" Type=\"Edm.String\" MaxLength=\"14\" Nullable=\"false\"/>\n        <Property Name=\"name\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"descr\" Type=\"Edm.String\" MaxLength=\"1000\"/>\n        <Property Name=\"code\" Type=\"Edm.String\" Nullable=\"false\"/>\n      </EntityType>\n      <EntityType Name=\"Incidents_conversation\">\n        <Key>\n          <PropertyRef Name=\"up__ID\"/>\n          <PropertyRef Name=\"ID\"/>\n          <PropertyRef Name=\"IsActiveEntity\"/>\n        </Key>\n        <NavigationProperty Name=\"up_\" Type=\"ProcessorService.Incidents\" Nullable=\"false\" Partner=\"conversation\">\n          <ReferentialConstraint Property=\"up__ID\" ReferencedProperty=\"ID\"/>\n        </NavigationProperty>\n        <Property Name=\"up__ID\" Type=\"Edm.Guid\" Nullable=\"false\"/>\n        <Property Name=\"ID\" Type=\"Edm.Guid\" Nullable=\"false\"/>\n        <Property Name=\"timestamp\" Type=\"Edm.DateTimeOffset\" Precision=\"7\"/>\n        <Property Name=\"author\" Type=\"Edm.String\" MaxLength=\"255\"/>\n        <Property Name=\"message\" Type=\"Edm.String\"/>\n        <Property Name=\"IsActiveEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"true\"/>\n        <Property Name=\"HasActiveEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"false\"/>\n        <Property Name=\"HasDraftEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"false\"/>\n        <NavigationProperty Name=\"DraftAdministrativeData\" Type=\"ProcessorService.DraftAdministrativeData\" ContainsTarget=\"true\"/>\n        <NavigationProperty Name=\"SiblingEntity\" Type=\"ProcessorService.Incidents_conversation\"/>\n        <Property Name=\"DraftMessages\" Type=\"Collection(ProcessorService.DRAFT_DraftAdministrativeData_DraftMessage)\" Nullable=\"true\"/>\n      </EntityType>\n      <EntityType Name=\"Incidents_processors\">\n        <Key>\n          <PropertyRef Name=\"up__ID\"/>\n          <PropertyRef Name=\"processor_ID\"/>\n          <PropertyRef Name=\"IsActiveEntity\"/>\n        </Key>\n        <NavigationProperty Name=\"up_\" Type=\"ProcessorService.Incidents\" Nullable=\"false\" Partner=\"processors\">\n          <ReferentialConstraint Property=\"up__ID\" ReferencedProperty=\"ID\"/>\n        </NavigationProperty>\n        <Property Name=\"up__ID\" Type=\"Edm.Guid\" Nullable=\"false\"/>\n        <NavigationProperty Name=\"processor\" Type=\"ProcessorService.Processors\" Partner=\"incidents\">\n          <ReferentialConstraint Property=\"processor_ID\" ReferencedProperty=\"ID\"/>\n        </NavigationProperty>\n        <Property Name=\"processor_ID\" Type=\"Edm.String\" Nullable=\"false\"/>\n        <Property Name=\"IsActiveEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"true\"/>\n        <Property Name=\"HasActiveEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"false\"/>\n        <Property Name=\"HasDraftEntity\" Type=\"Edm.Boolean\" Nullable=\"false\" DefaultValue=\"false\"/>\n        <NavigationProperty Name=\"DraftAdministrativeData\" Type=\"ProcessorService.DraftAdministrativeData\" ContainsTarget=\"true\"/>\n        <NavigationProperty Name=\"